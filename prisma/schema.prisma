generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER

  @@map("user_role")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

model Teacher {
  id          Int      @id @default(autoincrement())
  teacherCode String   @unique @map("teacher_code") @db.VarChar(20)
  fullName    String   @map("full_name") @db.VarChar(100)
  email       String?  @unique @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  subject     String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User?
  classes Class[]

  @@map("teachers")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  role         UserRole @default(TEACHER)
  teacherId    Int?     @unique @map("teacher_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Class {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(20)
  schoolYear        String   @map("school_year") @db.VarChar(9)
  homeroomTeacherId Int?     @map("homeroom_teacher_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  homeroomTeacher Teacher?  @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  students        Student[]

  @@unique([name, schoolYear])
  @@index([homeroomTeacherId])
  @@map("classes")
}

model Student {
  id          Int      @id @default(autoincrement())
  studentCode String   @unique @map("student_code") @db.VarChar(20)
  fullName    String   @map("full_name") @db.VarChar(100)
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  gender      Gender
  address     String?
  email       String?  @unique @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  classId     Int      @map("class_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@index([classId])
  @@index([fullName])
  @@index([createdAt(sort: Desc)])
  @@map("students")
}
